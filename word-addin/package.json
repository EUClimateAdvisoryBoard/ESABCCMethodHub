{
  "name": "esabcc-refmanager-word-addin",
  "version": "1.0.0",
  "description": "ESABCC Reference Manager - Word Add-in for citation management",
  "private": true,
  "scripts": {
    "dev:server": "webpack serve --mode development --config webpack.config.js",
    "build": "webpack --mode production --config webpack.config.js",

    "dev": "office-addin-debugging start manifest.xml",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",

    "sideload": "office-addin-dev-settings sideload manifest.xml",
    "unload": "office-addin-dev-settings remove manifest.xml",

    "install-certs": "office-addin-dev-certs install",
    "verify-certs": "office-addin-dev-certs verify",

    "validate": "office-addin-manifest-converter validate manifest.xml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^7.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.1.0",
    "office-addin-dev-certs": "^1.13.0",
    "office-addin-dev-settings": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.0.0"
  },
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3001
  }
}
