<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <Id>e5b3c0f2-7a8e-4d6b-9c1a-2f3e4d5b6c7a</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>ESABCC</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="ESABCC Reference Manager" />
  <Description DefaultValue="Insert citations, references, and bibliographies from the ESABCC reference library. Supports EEA citation style with 2,600+ references." />

  <IconUrl DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-64.png" />
  <SupportUrl DefaultValue="https://eu-climate-policy.vercel.app/" />

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="WordApi" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://eu-climate-policy.vercel.app/word-addin/" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- ═══ Custom Ribbon Tab ═══ -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>

          <!-- Function file for executeFunction actions -->
          <FunctionFile resid="Functions.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <!-- ─── Custom Tab: ESABCC References ─── -->
            <CustomTab id="ESABCC.Tab">
              <Label resid="Tab.Label" />

              <!-- Group 1: Insert -->
              <Group id="ESABCC.InsertGroup">
                <Label resid="InsertGroup.Label" />

                <!-- Insert Citation — opens taskpane on Search tab -->
                <Control xsi:type="Button" id="ESABCC.InsertCitation">
                  <Label resid="InsertCitation.Label" />
                  <Supertip>
                    <Title resid="InsertCitation.Label" />
                    <Description resid="InsertCitation.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>

                <!-- Insert Bibliography — opens taskpane on Selected tab -->
                <Control xsi:type="Button" id="ESABCC.InsertBibliography">
                  <Label resid="InsertBiblio.Label" />
                  <Supertip>
                    <Title resid="InsertBiblio.Label" />
                    <Description resid="InsertBiblio.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="BiblioIcon.16x16" />
                    <bt:Image size="32" resid="BiblioIcon.32x32" />
                    <bt:Image size="80" resid="BiblioIcon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.BiblioPane</TaskpaneId>
                    <SourceLocation resid="BiblioPane.Url" />
                  </Action>
                </Control>

                <!-- Insert Footnote — opens taskpane in footnote mode -->
                <Control xsi:type="Button" id="ESABCC.InsertFootnote">
                  <Label resid="InsertFootnote.Label" />
                  <Supertip>
                    <Title resid="InsertFootnote.Label" />
                    <Description resid="InsertFootnote.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="FootnoteIcon.16x16" />
                    <bt:Image size="32" resid="FootnoteIcon.32x32" />
                    <bt:Image size="80" resid="FootnoteIcon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.FootnotePane</TaskpaneId>
                    <SourceLocation resid="FootnotePane.Url" />
                  </Action>
                </Control>
              </Group>

              <!-- Group 2: Reference Manager -->
              <Group id="ESABCC.ManagerGroup">
                <Label resid="ManagerGroup.Label" />

                <!-- Open Reference Manager (full web app) -->
                <Control xsi:type="Button" id="ESABCC.OpenManager">
                  <Label resid="OpenManager.Label" />
                  <Supertip>
                    <Title resid="OpenManager.Label" />
                    <Description resid="OpenManager.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="ManagerIcon.16x16" />
                    <bt:Image size="32" resid="ManagerIcon.32x32" />
                    <bt:Image size="80" resid="ManagerIcon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.ManagerPane</TaskpaneId>
                    <SourceLocation resid="ManagerPane.Url" />
                  </Action>
                </Control>

                <!-- Add by DOI -->
                <Control xsi:type="Button" id="ESABCC.AddByDOI">
                  <Label resid="AddDOI.Label" />
                  <Supertip>
                    <Title resid="AddDOI.Label" />
                    <Description resid="AddDOI.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="DOIIcon.16x16" />
                    <bt:Image size="32" resid="DOIIcon.32x32" />
                    <bt:Image size="80" resid="DOIIcon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.DOIPane</TaskpaneId>
                    <SourceLocation resid="DOIPane.Url" />
                  </Action>
                </Control>

                <!-- Discover Similar Papers -->
                <Control xsi:type="Button" id="ESABCC.Discover">
                  <Label resid="Discover.Label" />
                  <Supertip>
                    <Title resid="Discover.Label" />
                    <Description resid="Discover.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="DiscoverIcon.16x16" />
                    <bt:Image size="32" resid="DiscoverIcon.32x32" />
                    <bt:Image size="80" resid="DiscoverIcon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.DiscoverPane</TaskpaneId>
                    <SourceLocation resid="DiscoverPane.Url" />
                  </Action>
                </Control>
              </Group>

              <!-- Group 3: Style -->
              <Group id="ESABCC.StyleGroup">
                <Label resid="StyleGroup.Label" />

                <!-- Citation Style info -->
                <Control xsi:type="Button" id="ESABCC.StyleGuide">
                  <Label resid="StyleGuide.Label" />
                  <Supertip>
                    <Title resid="StyleGuide.Label" />
                    <Description resid="StyleGuide.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="StyleIcon.16x16" />
                    <bt:Image size="32" resid="StyleIcon.32x32" />
                    <bt:Image size="80" resid="StyleIcon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ESABCC.StylePane</TaskpaneId>
                    <SourceLocation resid="StylePane.Url" />
                  </Action>
                </Control>
              </Group>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- ═══ Resources ═══ -->
    <Resources>
      <bt:Images>
        <!-- Shared icons (reused across buttons — in production, use distinct icons) -->
        <bt:Image id="Icon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
        <bt:Image id="BiblioIcon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="BiblioIcon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="BiblioIcon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
        <bt:Image id="FootnoteIcon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="FootnoteIcon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="FootnoteIcon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
        <bt:Image id="ManagerIcon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="ManagerIcon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="ManagerIcon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
        <bt:Image id="DOIIcon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="DOIIcon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="DOIIcon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
        <bt:Image id="DiscoverIcon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="DiscoverIcon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="DiscoverIcon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
        <bt:Image id="StyleIcon.16x16" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-16.png" />
        <bt:Image id="StyleIcon.32x32" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-32.png" />
        <bt:Image id="StyleIcon.80x80" DefaultValue="https://eu-climate-policy.vercel.app/addin-icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Functions.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/functions.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=in-text" />
        <bt:Url id="BiblioPane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=bibliography" />
        <bt:Url id="FootnotePane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=footnote" />
        <bt:Url id="ManagerPane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=manager" />
        <bt:Url id="DOIPane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=doi" />
        <bt:Url id="DiscoverPane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=discover" />
        <bt:Url id="StylePane.Url" DefaultValue="https://eu-climate-policy.vercel.app/word-addin/?mode=style" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://eu-climate-policy.vercel.app/" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="ESABCC Reference Manager" />
        <bt:String id="Tab.Label" DefaultValue="ESABCC References" />
        <bt:String id="InsertGroup.Label" DefaultValue="Insert" />
        <bt:String id="InsertCitation.Label" DefaultValue="Insert Citation" />
        <bt:String id="InsertBiblio.Label" DefaultValue="Bibliography" />
        <bt:String id="InsertFootnote.Label" DefaultValue="Footnote" />
        <bt:String id="ManagerGroup.Label" DefaultValue="Reference Manager" />
        <bt:String id="OpenManager.Label" DefaultValue="Reference Manager" />
        <bt:String id="AddDOI.Label" DefaultValue="Add by DOI" />
        <bt:String id="Discover.Label" DefaultValue="Discover Papers" />
        <bt:String id="StyleGroup.Label" DefaultValue="Citation Style" />
        <bt:String id="StyleGuide.Label" DefaultValue="EEA Style Guide" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Search and insert EEA-formatted citations from the ESABCC reference library with 2,600+ references." />
        <bt:String id="InsertCitation.Tooltip" DefaultValue="Search the reference library and insert an in-text citation (Author, Year) at the cursor position." />
        <bt:String id="InsertBiblio.Tooltip" DefaultValue="Generate and insert a formatted EEA-style bibliography from your selected references." />
        <bt:String id="InsertFootnote.Tooltip" DefaultValue="Insert an abbreviated footnote citation at the cursor position." />
        <bt:String id="OpenManager.Tooltip" DefaultValue="Open the full reference manager to browse, search, and manage your reference library." />
        <bt:String id="AddDOI.Tooltip" DefaultValue="Add a new reference by entering its DOI. Metadata is fetched automatically from CrossRef." />
        <bt:String id="Discover.Tooltip" DefaultValue="Find related papers using Semantic Scholar based on topics or existing references." />
        <bt:String id="StyleGuide.Tooltip" DefaultValue="View the EEA referencing style guide for in-text citations, full references, and footnotes." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
