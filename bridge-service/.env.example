# Bridge Service Environment Variables
# Copy this file to .env and fill in your values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
BRIDGE_PORT=8585

# REQUIRED. Bearer token that the Word add-in / Electron client must send
# in the Authorization header. Without this set the bridge refuses to
# start (it would otherwise let any process on localhost read your
# library). Generate with `openssl rand -hex 32`.
BRIDGE_AUTH_TOKEN=
