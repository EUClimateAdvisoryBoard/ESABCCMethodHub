# ── Data layer provider selection ────────────────────────
# Controls which backend powers the app. Keep "supabase" in production
# until the cutover has been validated in staging via
# scripts/migrate-to-postgres/verify-parity.mjs. Each concern has its own
# flag so Auth, Storage and Realtime can migrate independently from the DB.
# DB_PROVIDER=supabase          # supabase | postgres
# AUTH_PROVIDER=supabase        # supabase | oidc
# STORAGE_PROVIDER=supabase     # supabase | s3
# REALTIME_PROVIDER=supabase    # supabase | postgres | none

# Self-hosted Postgres — only used when DB_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host:5432/eu_climate
# DATABASE_SSL=require          # "disable" to turn TLS off for local dev
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Supabase — required while DB_PROVIDER=supabase (default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SET ONLY IN PRODUCTION (Vercel project env / IT secret
# store). It bypasses every RLS policy, so a leak compromises every user's
# personal data. Do NOT copy this line into your local .env.local for day-
# to-day development; the anon key above is enough for the UI.
# SUPABASE_SERVICE_ROLE_KEY=

# Supabase direct DB connection — only needed for migration tooling
# SUPABASE_DB_URL=postgres://postgres:PW@db.PROJECT.supabase.co:5432/postgres

# ── LLM provider for AI summaries (pick ONE) ──────────────────────
# Azure OpenAI — use your org's enterprise Copilot / Azure OpenAI deployment
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Anthropic — enables AI summaries on news feed + Brussels Bulletin generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Inbound email webhook secret (used as ?secret= query or Bearer header)
INBOUND_EMAIL_SECRET=esabcc-email-webhook-2024

# Media monitoring — shared secret for cron-triggered fetch runs.
MEDIA_MONITORING_SECRET=

# PyPSA backend URL — proxy target for energy-system / maritime-aviation /
# electricity-maps API routes. Defaults to localhost:8001 for local dev.
PYPSA_SERVICE_URL=http://localhost:8001

# ── Optional API keys ───────────────────────────────────
# ELECTRICITY_MAPS_TOKEN=
# FEIA_API_KEY=
# GNEWS_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=
# AUTO_LLM_SUMMARIZATION_ENABLED=false
# API_EXTRA_ALLOWED_ORIGINS=

# GitHub PAT — DISABLED in EEA deployment. Custom references are now
# stored in Postgres (see supabase/migrations/018_custom_references_store.sql).
# Leave this empty.
# REFS_GITHUB_TOKEN=

# REFS_ADMIN_TOKEN=
# RETENTION_CRON_SECRET=
# ADMIN_EMAILS=
